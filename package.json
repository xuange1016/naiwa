{
  "name": "naiwa-desktop-pet",
  "description": "Interactive Naiwa desktop pet with dragging, resizing, mirroring, cloning, and an action library.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "assets:naiwa": "node scripts/generate-pet-assets.mjs naiwa.mp4 public/pets/naiwa",
    "assets:action": "node scripts/generate-action-assets.mjs"
  },
  "keywords": [
    "desktop-pet",
    "tauri",
    "typescript",
    "naiwa"
  ],
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
